#!/usr/bin/env python3
"""
牌堆管理器 - 支持多牌堆配置切换
"""

import json
import os
from typing import Dict, List, Any, Optional
from pathlib import Path


class DeckManager:
    """牌堆管理器"""
    
    def __init__(self, project_root: str):
        self.project_root = Path(project_root)
        self.registry_path = self.project_root / "card_decks" / "deck_registry.json"
        self.registry = self._load_registry()
        self.active_deck = None
        self._load_active_deck()
    
    def _load_registry(self) -> Dict:
        """加载牌堆注册表"""
        if not self.registry_path.exists():
            return {"decks": [], "settings": {"active_deck": "test_deck"}}
        
        with open(self.registry_path, 'r', encoding='utf-8') as f:
            return json.load(f)
    
    def _save_registry(self):
        """保存牌堆注册表"""
        self.registry_path.parent.mkdir(parents=True, exist_ok=True)
        with open(self.registry_path, 'w', encoding='utf-8') as f:
            json.dump(self.registry, f, ensure_ascii=False, indent=2)
    
    def _load_active_deck(self):
        """加载当前激活的牌堆"""
        active_id = self.registry["settings"]["active_deck"]
        for deck in self.registry["decks"]:
            if deck["id"] == active_id:
                self.active_deck = deck
                break
        
        if not self.active_deck:
            # 默认使用第一个
            self.active_deck = self.registry["decks"][0] if self.registry["decks"] else None
    
    def get_active_deck_id(self) -> str:
        """获取当前激活的牌堆ID"""
        return self.active_deck["id"] if self.active_deck else "test_deck"
    
    def get_active_deck_name(self) -> str:
        """获取当前激活的牌堆名称"""
        return self.active_deck["name"] if self.active_deck else "测试版"
    
    def get_deck_list(self) -> List[Dict]:
        """获取所有牌堆列表"""
        return self.registry["decks"]
    
    def switch_deck(self, deck_id: str) -> bool:
        """切换牌堆"""
        for deck in self.registry["decks"]:
            if deck["id"] == deck_id:
                # 更新激活状态
                for d in self.registry["decks"]:
                    d["enabled"] = (d["id"] == deck_id)
                
                self.registry["settings"]["active_deck"] = deck_id
                self.active_deck = deck
                self._save_registry()
                return True
        
        return False
    
    def load_deck_cards(self) -> List[Dict]:
        """加载当前牌堆的所有卡牌数据"""
        if not self.active_deck:
            return []
        
        cards = []
        data_path = self.project_root / self.active_deck["data_path"]
        
        # 测试版：从worldbook_generated加载
        if self.active_deck["id"] == "test_deck":
            basic_path = data_path / "basic_cards.json"
            trick_path = data_path / "trick_cards.json"
            equipment_path = data_path / "equipment_cards.json"
            
            for path in [basic_path, trick_path, equipment_path]:
                if path.exists():
                    with open(path, 'r', encoding='utf-8') as f:
                        data = json.load(f)
                        cards.extend(data.get("cards", []))
        
        # 完整版：从worldbook + extended加载
        elif self.active_deck["id"] == "complete_deck":
            # 先加载测试版的牌
            worldbook_path = self.project_root / "worldbook_generated/cards"
            for name in ["basic_cards.json", "trick_cards.json", "equipment_cards.json"]:
                path = worldbook_path / name
                if path.exists():
                    with open(path, 'r', encoding='utf-8') as f:
                        data = json.load(f)
                        cards.extend(data.get("cards", []))
            
            # 再加载扩展卡牌（酒、铁索、乐不思蜀等）
            extended_path = data_path / "extended_cards.json"
            if extended_path.exists():
                with open(extended_path, 'r', encoding='utf-8') as f:
                    data = json.load(f)
                    cards.extend(data.get("cards", []))
        
        return cards
    
    def get_card_image_path(self, card_name: str) -> str:
        """获取卡牌图片路径"""
        if not self.active_deck:
            return f"assets/cards/{card_name}.png"
        
        # 根据牌堆配置返回图片路径
        base_path = self.active_deck.get("image_base", "frontend/assets/cards/test/")
        
        # 映射卡牌名到文件名
        name_map = {
            "杀": "sha",
            "闪": "shan",
            "桃": "tao",
            "酒": "jiu",
            "过河拆桥": "guohe",
            "顺手牵羊": "shunshou",
            "无懈可击": "wuxie",
            "决斗": "juedou",
            "火攻": "huogong",
            "铁索连环": "tiesuo",
            "兵粮寸断": "bingliang",
            "乐不思蜀": "lebu",
            "南蛮入侵": "nanman",
            "万箭齐发": "wanjian",
            "桃园结义": "taoyuan",
            "五谷丰登": "wugu",
            "借刀杀人": "jiedao",
            "无中生有": "wuzhongshengyou"
        }
        
        filename = name_map.get(card_name, card_name)
        return f"{base_path}{filename}.png"
    
    def get_deck_info(self) -> Dict:
        """获取当前牌堆信息"""
        if not self.active_deck:
            return {}
        
        return {
            "id": self.active_deck["id"],
            "name": self.active_deck["name"],
            "description": self.active_deck["description"],
            "cards_count": self.active_deck["cards_count"],
            "includes": self.active_deck["includes"]
        }
