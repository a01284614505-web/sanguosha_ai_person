<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>游戏中 - 三国杀酒馆</title>
    <style>
        *{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
        body{width:100vw;height:100vh;overflow:hidden;background:linear-gradient(135deg,#1a1410,#2d1f1a);font-family:-apple-system,sans-serif;color:#f5e6d3;user-select:none}

        #opponents{position:absolute;top:0;left:0;right:0;height:22%;display:flex;justify-content:space-around;align-items:center;padding:4px;background:rgba(0,0,0,.25)}
        .pl{width:72px;background:rgba(42,31,26,.93);border:2px solid #5a4a3a;border-radius:8px;padding:4px;text-align:center;transition:all .3s;position:relative}
        .pl.cur{border-color:#ff4444;box-shadow:0 0 14px rgba(255,68,68,.5);transform:scale(1.06)}
        .pl.targetable{border-color:#44ff44!important;box-shadow:0 0 14px rgba(68,255,68,.6)!important;cursor:pointer;animation:pulse .8s infinite}
        .pl.chosen{border-color:#ffd700!important;box-shadow:0 0 14px rgba(255,215,0,.7)!important}
        @keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.08)}}
        .pl .av{width:100%;height:48px;border-radius:5px;display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:bold;color:#fff;margin-bottom:2px;background:linear-gradient(135deg,#8b4513,#d4af37)}
        .pl .nm{color:#d4af37;font-size:10px;font-weight:bold;margin-bottom:1px;overflow:hidden;white-space:nowrap}
        .pl .hp{font-size:11px;color:#ff6666}
        .pl .hc{font-size:9px;color:#8a7a6a}
        .pl.dead{opacity:.3;border-color:#444}

        /* 中央游戏区 - 包含弃牌堆 */
        #center{position:absolute;top:22%;left:0;right:0;height:38%;display:flex;align-items:center;justify-content:center;flex-direction:column}
        #center h2{font-size:24px;color:#d4af37;margin-bottom:4px;text-align:center}
        #center p{font-size:13px;color:#8a7a6a;text-align:center}

        /* 弃牌堆 */
        #discardPile{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:80px;height:100px;border:2px dashed #5a4a3a;border-radius:8px;background:rgba(42,31,26,.5);display:flex;align-items:center;justify-content:center;flex-direction:column;cursor:pointer;transition:.3s}
        #discardPile:hover{border-color:#d4af37;background:rgba(42,31,26,.8)}
        #discardPile .count{font-size:24px;color:#d4af37;font-weight:bold}
        #discardPile .label{font-size:10px;color:#8a7a6a;margin-top:4px}
        #discardPile .topCard{position:absolute;width:60px;height:80px;background:linear-gradient(135deg,#f5e6d3,#e5d6c3);border:2px solid #8b7355;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:bold;color:#333;pointer-events:none;opacity:0;transition:opacity .3s}
        #discardPile .topCard.show{opacity:1}

        /* 飞行卡牌动画 */
        .flyingCard{position:fixed;width:60px;height:85px;background:linear-gradient(135deg,#f5e6d3,#e5d6c3);border:2px solid #8b7355;border-radius:6px;padding:3px;z-index:999;pointer-events:none;box-shadow:0 8px 20px rgba(0,0,0,.4)}
        .flyingCard .cn{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-size:18px;font-weight:bold;color:#333}
        .flyingCard .cs{position:absolute;top:2px;left:2px;font-size:9px;font-weight:bold}
        .flyingCard .cs.r{color:#c41e3a}
        .flyingCard .cs.b{color:#000}

        #myarea{position:absolute;bottom:0;left:0;right:0;height:40%;background:rgba(26,20,18,.95);border-top:3px solid #d4af37}
        #myinfo{height:32%;display:flex;align-items:center;padding:8px 12px;border-bottom:1px solid #3d2f2a}
        #myav{width:52px;height:52px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:26px;font-weight:bold;color:#fff;margin-right:10px;background:linear-gradient(135deg,#2d5940,#4a7c5e);border:2px solid #d4af37}
        #myname{font-size:15px;font-weight:bold;color:#d4af37}
        #myhp{font-size:18px;color:#ff6666;margin:2px 0}
        #myhc{font-size:12px;color:#8a7a6a}
        #actionHint{font-size:13px;color:#44ff44;margin-top:4px;display:none}

        #hand{height:68%;padding:8px;overflow-x:auto;white-space:nowrap;display:flex;align-items:flex-end}
        #hand::-webkit-scrollbar{height:3px}
        #hand::-webkit-scrollbar-thumb{background:#d4af37}
        .card{display:inline-block;width:58px;height:82px;margin:0 4px;border:2px solid #5a4a4a;border-radius:5px;padding:3px;cursor:pointer;transition:all .25s;position:relative;vertical-align:bottom;flex-shrink:0;background:linear-gradient(135deg,#f5e6d3,#e5d6c3)}
        .card:active{transform:translateY(-8px)}
        .card.sel{transform:translateY(-18px)!important;border-color:#ff4444!important;box-shadow:0 8px 22px rgba(255,68,68,.6)!important}
        .card .cs{position:absolute;top:2px;left:2px;font-size:9px;font-weight:bold}
        .card .cs.r{color:#c41e3a}
        .card .cs.b{color:#000}
        .card .cn{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-size:18px;font-weight:bold;color:#333}

        #btns{position:fixed;right:6px;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;gap:6px;z-index:100}
        #btns button{width:56px;padding:10px 4px;border:2px solid #d4af37;border-radius:8px;color:#fff;font-size:11px;font-weight:bold;cursor:pointer;transition:all .2s}
        #btns button:active{transform:scale(.92)}
        #btns button:disabled{opacity:.3}
        .btn-play{background:linear-gradient(135deg,#c41e3a,#8b1526)}
        .btn-end{background:linear-gradient(135deg,#666,#444)}

        #info{position:fixed;top:6px;right:6px;background:rgba(42,31,26,.95);border:2px solid #d4af37;border-radius:6px;padding:6px 8px;z-index:99;font-size:10px}
        #info span{color:#f5e6d3;font-weight:bold}

        #logWrap{position:fixed;width:min(calc(100vw - 16px), 760px);max-width:calc(100vw - 16px);height:96px;max-height:96px;background:rgba(26,20,18,.92);border:2px solid #d4af37;border-radius:4px;font-size:9px;color:#f5e6d3;z-index:98;left:50%;transform:translateX(-50%);transition:height .3s ease}
        #log{height:100%;overflow-y:auto;padding:3px 6px 3px 30px;box-sizing:border-box}
        #log .im{color:#ff6666;font-weight:bold}
        #log .chat{color:#44ff44}
        #logWrap.expanded{height:min(50vh, 360px);max-height:min(50vh, 360px)}
        #logToggle{position:absolute;top:4px;left:4px;width:22px;height:22px;background:rgba(212,175,55,.9);border:1px solid #d4af37;border-radius:4px;color:#1a1410;font-size:14px;font-weight:bold;cursor:pointer;display:flex;align-items:center;justify-content:center;z-index:99;transition:.2s}
        #logToggle:active{transform:scale(.9)}

        #sbtn{position:fixed;top:6px;left:6px;width:30px;height:30px;background:rgba(42,31,26,.95);border:2px solid #d4af37;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:15px;color:#d4af37;cursor:pointer;z-index:100}

        .btn-skill{background:linear-gradient(135deg,#8b5a2b,#d4af37)}
        .btn-danger{background:linear-gradient(135deg,#8b1526,#3f0812)}
        #systemToasts{position:fixed;top:23%;left:50%;transform:translateX(-50%);width:min(78vw,520px);display:flex;flex-direction:column;align-items:center;gap:5px;z-index:1200;pointer-events:none}
        .system-toast{background:rgba(5,45,20,.94);border:1px solid #4cff75;border-radius:7px;padding:6px 14px;color:#7dff9c;font-size:14px;font-weight:bold;box-shadow:0 0 14px rgba(76,255,117,.35);animation:toastIn .15s ease-out}
        @keyframes toastIn{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:none}}
        .info-modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.72);z-index:1500;align-items:center;justify-content:center;padding:12px}
        .info-modal.show{display:flex}
        .modal-card{width:min(92vw,520px);max-height:88vh;overflow:auto;background:#2a1f1a;border:2px solid #d4af37;border-radius:12px;padding:16px;box-shadow:0 15px 45px rgba(0,0,0,.6)}
        .modal-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;color:#d4af37}
        .modal-close,.mini-gear{border:1px solid #d4af37;background:#1a1410;color:#d4af37;border-radius:6px;padding:5px 9px;cursor:pointer}
        .skill-entry{border-left:3px solid #d4af37;background:rgba(0,0,0,.25);padding:8px;margin:7px 0;border-radius:4px;font-size:13px}
        .skill-entry b{color:#ffd86b}
        .modal-field{display:flex;flex-direction:column;gap:4px;margin:9px 0;font-size:12px}
        .modal-field input,.modal-field select{background:#17110e;border:1px solid #6d5944;color:#f5e6d3;border-radius:5px;padding:8px}
        .modal-actions{display:flex;gap:8px;justify-content:flex-end;margin-top:12px}
        .modal-actions button{padding:8px 14px;border-radius:6px;border:1px solid #d4af37;background:#5c2e20;color:#fff}
        .avatar-click{cursor:pointer}
        .pl .gear{position:absolute;bottom:2px;right:2px;background:rgba(0,0,0,.75);border:1px solid #d4af37;border-radius:50%;width:18px;height:18px;font-size:10px;color:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer}
    </style>
</head>
<body>
    <div id="opponents"></div>
    <div id="center">
        <h2 id="phaseText">等待连接</h2>
        <p id="turnText"></p>
        <div id="discardPile">
            <div class="topCard" id="topCard"></div>
            <div class="count" id="discardCount">0</div>
            <div class="label">弃牌堆</div>
        </div>
    </div>
    <div id="myarea">
        <div id="myinfo">
            <div id="myav" class="avatar-click" onclick="openPlayerInfo(myId)">K</div>
            <div>
                <div id="myname">Kiro</div>
                <div id="myhp"></div>
                <div id="myhc">手牌：0张</div>
                <div id="actionHint">👆 选择卡牌</div>
            </div>
        </div>
        <div id="hand"></div>
    </div>
    <div id="btns">
        <button class="btn-play" id="playBtn" onclick="doPlay()" disabled>出牌</button>
        <button class="btn-skill" id="skillBtn" onclick="showMySkills()">技能</button>
        <button class="btn-end" id="endBtn" onclick="doEnd()" disabled>结束阶段</button>
        <button class="btn-danger" id="quitBtn" onclick="doEndGame()">结束游戏</button>
    </div>
    <div id="info"><div>回合<span id="rn">-</span></div><div>牌堆<span id="dc">-</span></div></div>
    <div id="logWrap"><div id="logToggle" onclick="toggleLog()">▼</div><div id="log"></div></div>
    <div id="systemToasts"></div>
    <div id="sbtn" onclick="openGlobalSettings()">⚙</div>

    <div id="playerInfoModal" class="info-modal" onclick="if(event.target===this)closeModal('playerInfoModal')">
        <div class="modal-card">
            <div class="modal-head"><h3 id="playerInfoTitle">武将信息</h3><button class="modal-close" onclick="closeModal('playerInfoModal')">关闭</button></div>
            <div id="playerInfoBody"></div>
        </div>
    </div>
    <div id="aiSettingsModal" class="info-modal" onclick="if(event.target===this)closeModal('aiSettingsModal')">
        <div class="modal-card">
            <div class="modal-head"><h3 id="aiSettingsTitle">AI模型设置</h3><button class="modal-close" onclick="closeModal('aiSettingsModal')">关闭</button></div>
            <input type="hidden" id="aiSettingPlayerId">
            <label class="modal-field">Provider<select id="aiSettingProvider"><option value="deepseek">DeepSeek</option><option value="qwen">Qwen</option><option value="openai">OpenAI兼容</option><option value="glm">GLM</option><option value="grok">Grok</option><option value="doubao">豆包</option></select></label>
            <label class="modal-field">Model<input id="aiSettingModel"></label>
            <label class="modal-field">API地址<input id="aiSettingUrl" placeholder="可留空使用默认地址"></label>
            <label class="modal-field">新API Key<input id="aiSettingKey" type="password" placeholder="留空则保留原Key"></label>
            <label class="modal-field">Temperature<input id="aiSettingTemperature" type="number" min="0" max="2" step="0.1"></label>
            <label class="modal-field"><span><input id="aiSettingThinking" type="checkbox"> 启用思考模式标记</span></label>
            <div class="modal-actions"><button onclick="saveAISettings()">保存并立即生效</button></div>
        </div>
    </div>

    <script src="js/audio.js"></script>
    <script src="js/ws_client.js?v=20260803c"></script>
    <script src="js/global_settings.js?v=20260803c"></script>
    <script>
        var sel=null,hand=[],hero,myId=null,needTarget=false,pendingAction=null,availableActions=[],selectedLegalAction=null;
        var gameConfig=JSON.parse(localStorage.getItem('gameConfig')||'{}');
        var playerName=gameConfig.player_name||'玩家';
        var latestState=null;

        function L(m,isChat){
            var l=document.getElementById('log'),d=document.createElement('div');
            d.className=isChat?'chat':'';
            d.textContent=m;
            l.appendChild(d);
            l.scrollTop=l.scrollHeight;
            if(l.children.length>50)l.removeChild(l.firstChild);
        }

        // 所有角色共用卡牌展示队列：来源位置 → 中央亮牌 → 弃牌堆。
        var cardAnimationQueue=Promise.resolve();

        function getCardSourcePosition(data){
            if(data.actor_id===myId&&Number.isInteger(data.card_index)){
                var ownCard=document.getElementById('hand').children[data.card_index];
                if(ownCard){
                    var ownRect=ownCard.getBoundingClientRect();
                    return {x:ownRect.left,y:ownRect.top};
                }
            }
            var actor=document.getElementById('opp_'+data.actor_id);
            if(actor){
                var actorRect=actor.getBoundingClientRect();
                return {x:actorRect.left+actorRect.width/2-30,y:actorRect.top+actorRect.height/2-42};
            }
            return {x:window.innerWidth/2-30,y:window.innerHeight/2-42};
        }

        function enqueueCardAnimation(data){
            cardAnimationQueue=cardAnimationQueue.then(function(){
                return animateCardToDiscard(data);
            }).catch(function(error){
                console.error('卡牌动画失败:',error);
            });
        }

        function animateCardToDiscard(data){
            return new Promise(function(resolve){
                var card=data.card||{};
                var start=getCardSourcePosition(data);
                var fly=document.createElement('div');
                fly.className='flyingCard';
                var suitSym={spade:'♠',heart:'♥',club:'♣',diamond:'♦'}[card.suit]||'?';
                var col=['heart','diamond'].includes(card.suit)?'r':'b';
                fly.innerHTML='<div class="cs '+col+'">'+suitSym+(card.rank||'')+'</div><div class="cn">'+(card.name||data.card_name||'?')+'</div>';
                fly.style.left=start.x+'px';
                fly.style.top=start.y+'px';
                document.body.appendChild(fly);

                var animationMs=(window.getGlobalSettings?getGlobalSettings().animation_ms:1100);
                var centerPause=Math.round(animationMs*.59);
                var centerMove=Math.max(260,Math.round(animationMs*.35));
                var discardMove=Math.max(280,animationMs-centerPause);
                var centerX=window.innerWidth/2-30;
                var centerY=Math.max(38,window.innerHeight*.29-42);
                var pileRect=document.getElementById('discardPile').getBoundingClientRect();
                var pileX=pileRect.left+pileRect.width/2-30;
                var pileY=pileRect.top+pileRect.height/2-42;

                requestAnimationFrame(function(){
                    fly.style.transition='all '+centerMove+'ms cubic-bezier(.2,.8,.2,1)';
                    fly.style.left=centerX+'px';
                    fly.style.top=centerY+'px';
                    fly.style.transform='scale(1.18)';
                    fly.style.boxShadow='0 0 28px rgba(212,175,55,.9)';
                });

                setTimeout(function(){
                    fly.style.transition='all '+discardMove+'ms cubic-bezier(.4,0,.2,1)';
                    fly.style.left=pileX+'px';
                    fly.style.top=pileY+'px';
                    fly.style.transform='scale(.78) rotate(10deg)';
                    fly.style.opacity='.82';
                },centerPause);

                setTimeout(function(){
                    if(fly.parentNode)fly.parentNode.removeChild(fly);
                    showDiscardTop(card.name||data.card_name);
                    if(Number.isInteger(data.discard_count)){
                        document.getElementById('discardCount').textContent=data.discard_count;
                    }
                    if(window.audioManager)audioManager.play('card');
                    if(data.animation_id){
                        gameClient.send({type:'card_animation_done',animation_id:data.animation_id});
                    }
                    resolve();
                },animationMs);
            });
        }

        function showDiscardTop(cardName){
            if(!cardName)return;
            var top=document.getElementById('topCard');
            top.textContent=cardName;
            top.classList.add('show');
            setTimeout(function(){top.classList.remove('show')},1200);
        }

        gameClient.onConnect=function(){
            L('已连接');
            hero=gameConfig.selected_hero||{id:'liubei',name:'界刘备',faction:'蜀',max_hp:4,skills:[]};
            playerName=gameConfig.player_name||'玩家';
            document.getElementById('myname').textContent=playerName;
            document.getElementById('myav').textContent=(hero.name||playerName).charAt(0);
            document.getElementById('myhp').textContent='❤️'.repeat(hero.max_hp||4);

            if(!Array.isArray(gameConfig.ais)||gameConfig.ais.length!==4){
                gameConfig={
                    mode:'5人身份局',player_name:playerName,selected_hero:hero,
                    ais:[
                        {name:'规则AI-曹操',provider:'deepseek',model:'deepseek-chat',apiKey:'test_key'},
                        {name:'规则AI-司马懿',provider:'deepseek',model:'deepseek-chat',apiKey:'test_key'},
                        {name:'规则AI-张辽',provider:'deepseek',model:'deepseek-chat',apiKey:'test_key'},
                        {name:'规则AI-关羽',provider:'deepseek',model:'deepseek-chat',apiKey:'test_key'}
                    ]
                };
            }
            gameConfig.player={name:playerName,is_ai:false,hero:hero};
            gameClient.createGame(gameConfig);
        };

        gameClient.onStateUpdate=function(s){
            latestState=s;
            document.getElementById('rn').textContent=s.round;
            document.getElementById('dc').textContent=s.deck_count;
            document.getElementById('discardCount').textContent=s.discard_count||0;
            document.getElementById('phaseText').textContent=s.phase||'进行中';
            document.getElementById('turnText').textContent=s.current_name+'的回合';

            var o=document.getElementById('opponents');o.innerHTML='';
            s.players.forEach(function(p){
                if(!p.hero_name||p.name===playerName)return;
                var d=document.createElement('div');
                d.className='pl'+(p.alive?'':' dead')+(p.name===s.current_name?' cur':'');
                d.id='opp_'+p.id;
                var identity_label = '';
                if(p.identity_revealed && p.identity){
                    var id_map = {lord:'主',loyalist:'忠',rebel:'反',spy:'内'};
                    identity_label = '<div style="position:absolute;top:2px;right:2px;background:#c41e3a;color:#fff;padding:2px 4px;border-radius:3px;font-size:9px;font-weight:bold">'+id_map[p.identity]+'</div>';
                }
                d.innerHTML=identity_label+'<div class="av avatar-click" onclick="event.stopPropagation();openPlayerInfo('+p.id+')">'+p.name.charAt(0)+'</div><div class="nm">'+p.name+'</div><div class="hp">'+'❤️'.repeat(Math.max(0,p.hp))+'</div><div class="hc">'+p.hand_count+'张</div>'+(p.is_ai?'<div class="gear" onclick="event.stopPropagation();openAISettings('+p.id+')">⚙</div>':'');
                o.appendChild(d);
            });

            var me=s.players.find(function(p){return p.name===playerName});
            if(me){
                myId=me.id;  // 设置playerId
                document.getElementById('myhp').textContent='❤️'.repeat(Math.max(0,me.hp));
                document.getElementById('myhc').textContent='手牌：'+me.hand_count+'张';
                if(me.identity){
                    var id_text={lord:'主公',loyalist:'忠臣',rebel:'反贼',spy:'内奸'}[me.identity];
                    document.getElementById('myname').textContent=playerName+' ('+id_text+')';
                }
            }
        };

        gameClient.onYourTurn=function(data){
            L('⚔️ 你的回合！');
            hand=data.hand||[];availableActions=data.actions||[];sel=null;needTarget=false;pendingAction=null;selectedLegalAction=null;
            document.getElementById('actionHint').style.display='block';
            document.getElementById('playBtn').textContent='出牌';
            renderHand();
            updateButtons();
            audioManager.play('click');
        };

        gameClient.onActionResult=function(ok){
            L(ok?'✅':'❌');
            if(!ok){sel=null;renderHand();updateButtons();}
        };

        gameClient.onChat=function(data){
            L('💬 '+data.from+': '+data.message,true);
            showSystemToast('['+(data.from||'AI')+'‘'+data.message+'’]');
        };

        gameClient.onEventNotification=function(data){
            if(data.event_kind==='card_to_discard'&&data.card){
                L('🃏 '+(data.message||((data.actor_name||'角色')+'使用【'+data.card.name+'】')));
                showSystemToast(data.system_text||('【'+(data.actor_name||'角色')+'】'+data.card.name+'！'));
                enqueueCardAnimation(data);
            }else if(data.event_kind==='skill_activation'){
                L('✨ '+(data.message||((data.actor_name||'角色')+'发动【'+data.skill_name+'】')));
                showSystemToast(data.system_text||('['+(data.actor_name||'角色')+'发动‘'+data.skill_name+'’]'));
            }else if(data.message){
                L(data.message);
            }
        };
        

        gameClient.onError=function(data){
            L('❌ '+(data.message||'服务器错误'));
            document.getElementById('phaseText').textContent='连接/游戏错误';
        };

        gameClient.onAIAction=function(data){
            if(data.action==='turn_start'){
                L('🤖 '+data.player_name+'的回合');
            }else if(data.action==='thinking_start'){
                if(!window.getGlobalSettings||getGlobalSettings().show_ai_thinking)L('🤔 '+data.player_name+'正在思考...');
            }else if(data.action==='thinking_end'){
                if(!window.getGlobalSettings||getGlobalSettings().show_ai_thinking)L('💡 '+data.player_name+'思考摘要：'+(data.reasoning||'已选择合法操作'));
            }else if(data.action==='use_card'){
                // 真实卡牌UI由服务端card_to_discard事件统一驱动。
            }
        };

        gameClient.onAIConfigUpdated=function(config){
            showSystemToast('AI模型设置已更新');
            closeModal('aiSettingsModal');
        };

        gameClient.onGameEnd=function(data){
            var state=data.state||latestState||{};
            var me=(state.players||[]).find(function(p){return p.id===myId})||{};
            var result={
                winner:data.winner,
                message:data.message,
                total_rounds:state.round||0,
                player_identity:me.identity||'未知',
                player_won:data.winner===me.identity||(data.winner==='lord'&&(me.identity==='lord'||me.identity==='loyalist')),
                players:state.players||[]
            };
            localStorage.setItem('gameResult',JSON.stringify(result));
            showSystemToast(data.message||'游戏结束');
            setTimeout(function(){location.href='result.html'},700);
        };

        function renderHand(){
            var h=document.getElementById('hand');h.innerHTML='';
            if(!hand.length){h.innerHTML='<div style="padding:20px;color:#8a7a6a">无手牌</div>';return}
            hand.forEach(function(c,i){
                var d=document.createElement('div');
                d.className='card'+(sel===i?' sel':'');
                var suit={spade:'♠',heart:'♥',club:'♣',diamond:'♦'}[c.suit]||'?';
                var col=['heart','diamond'].includes(c.suit)?'r':'b';
                d.innerHTML='<div class="cs '+col+'">'+suit+c.rank+'</div><div class="cn">'+c.name+'</div>';
                d.onclick=(function(idx){return function(){
                    sel=sel===idx?null:idx;
                    checkNeedTarget(sel);
                    renderHand();
                    updateButtons();
                }})(i);
                h.appendChild(d);
            });
        }

        function checkNeedTarget(idx){
            var c=hand[idx];
            selectedLegalAction=availableActions.find(function(a){
                return a.type==='play_card'&&a.card_index===idx;
            })||null;
            if(!selectedLegalAction){
                needTarget=false;
                pendingAction=null;
                document.getElementById('actionHint').textContent='🚫 当前不能使用此牌';
                highlightTargets(false,[]);
                return;
            }
            needTarget=!!selectedLegalAction.requires_target;
            if(needTarget){
                document.getElementById('actionHint').textContent='👆 点击绿色目标';
                highlightTargets(true,selectedLegalAction.valid_targets||[]);
            }else{
                document.getElementById('actionHint').textContent='👆 点击出牌';
                highlightTargets(false,[]);
            }
        }

        function highlightTargets(on,validIds){
            validIds=validIds||[];
            document.querySelectorAll('.pl').forEach(function(p){
                var pid=parseInt(p.id.replace('opp_',''));
                if(on&&validIds.includes(pid)&&!p.classList.contains('dead')){
                    p.classList.add('targetable');
                    p.onclick=function(){selectTarget(pid);};
                }else{
                    p.classList.remove('targetable');
                    p.onclick=null;
                }
            });
        }

        function selectTarget(tid){
            if(!selectedLegalAction||!(selectedLegalAction.valid_targets||[]).includes(parseInt(tid))){
                L('❌ 非法目标');
                return;
            }
            if(selectedLegalAction.type==='use_skill'){
                pendingAction=Object.assign({},selectedLegalAction,{target_ids:[parseInt(tid)]});
            }else{
                pendingAction={type:'play_card',card_index:sel,target_ids:[parseInt(tid)]};
            }
            highlightTargets(false,[]);
            document.querySelectorAll('.pl.chosen').forEach(function(p){p.classList.remove('chosen')});
            document.getElementById('opp_'+tid).classList.add('chosen');
            L('已选择目标');
            updateButtons();
        }

        function updateButtons(){
            var isSkill=selectedLegalAction&&selectedLegalAction.type==='use_skill';
            var hasSel=sel!==null||isSkill;
            var needsTarget=hasSel&&needTarget&&!pendingAction;
            document.getElementById('playBtn').disabled=!hasSel||!selectedLegalAction||needsTarget;
            document.getElementById('endBtn').disabled=false;
        }

        function showSystemToast(text){
            if(!text)return;
            var box=document.getElementById('systemToasts');
            var toast=document.createElement('div');
            toast.className='system-toast';
            toast.textContent=text;
            box.appendChild(toast);
            setTimeout(function(){
                toast.style.opacity='0';
                setTimeout(function(){if(toast.parentNode)toast.parentNode.removeChild(toast)},180);
            },1000);
        }

        function closeModal(id){document.getElementById(id).classList.remove('show')}

        function skillHTML(skills){
            if(!skills||!skills.length)return '<div class="skill-entry">暂无技能数据</div>';
            return skills.map(function(skill){
                var name=typeof skill==='string'?skill:(skill.name||'未命名技能');
                var desc=typeof skill==='string'?'':(skill.description||skill.detail||'技能逻辑尚未接入，当前仅展示数据。');
                var type=typeof skill==='string'?'':(skill.type||skill.trigger_event||'');
                return '<div class="skill-entry"><b>【'+name+'】</b> '+(type?'<small>'+type+'</small><br>':'')+desc+'</div>';
            }).join('');
        }

        function openPlayerInfo(playerId){
            if(!latestState)return;
            var p=latestState.players.find(function(x){return x.id===playerId});
            if(!p)return;
            document.getElementById('playerInfoTitle').textContent=p.name+' · '+(p.hero_name||'未知武将');
            var identity=p.identity?({lord:'主公',loyalist:'忠臣',rebel:'反贼',spy:'内奸'}[p.identity]||p.identity):'未公开';
            document.getElementById('playerInfoBody').innerHTML=
                '<p>势力：'+((p.hero||{}).faction||'未知')+'　体力：'+p.hp+'/'+p.max_hp+'　身份：'+identity+'</p>'+
                '<p style="margin-top:8px;color:#aaa">手牌：'+p.hand_count+'张　装备：'+Object.values(p.equipment||{}).join('、')+'</p>'+
                '<h4 style="margin-top:14px;color:#d4af37">武将技能</h4>'+skillHTML((p.hero||{}).skills)+
                (p.is_ai?'<div class="modal-actions"><button onclick="closeModal(&quot;playerInfoModal&quot;);openAISettings('+p.id+')">⚙ 调整该AI模型</button></div>':'');
            document.getElementById('playerInfoModal').classList.add('show');
        }

        function showMySkills(){
            if(myId===null){showSystemToast('游戏尚未初始化');return}
            if(!latestState)return;
            var p=latestState.players.find(function(x){return x.id===myId});
            if(!p)return;
            var legal=availableActions.filter(function(a){return a.type==='use_skill'});
            document.getElementById('playerInfoTitle').textContent=p.name+' · 技能';
            document.getElementById('playerInfoBody').innerHTML=
                '<h4 style="color:#d4af37">武将技能</h4>'+skillHTML((p.hero||{}).skills)+
                '<h4 style="margin-top:14px;color:#7dff9c">当前合法技能操作</h4>'+
                (legal.length?legal.map(function(a,i){
                    var cards=(a.card_indices||[]).map(function(idx){return hand[idx]?hand[idx].name:'#'+idx}).join('、');
                    return '<div class="skill-entry"><b>【'+a.skill_name+'】</b> '+(a.description||a.variant||'')+
                        (cards?'<br><small>消耗：'+cards+'</small>':'')+
                        '<div class="modal-actions"><button onclick="chooseSkillAction('+i+')">发动</button></div></div>';
                }).join(''):'<div class="skill-entry">当前阶段没有可主动发动的技能；锁定技和触发技由引擎自动结算。</div>');
            document.getElementById('playerInfoModal').dataset.skillActions=JSON.stringify(legal);
            document.getElementById('playerInfoModal').classList.add('show');
        }

        function chooseSkillAction(index){
            var actions=JSON.parse(document.getElementById('playerInfoModal').dataset.skillActions||'[]');
            var action=actions[index];
            if(!action)return;
            closeModal('playerInfoModal');
            sel=null;selectedLegalAction=action;pendingAction=null;needTarget=!!action.requires_target;
            if(needTarget){
                document.getElementById('actionHint').style.display='block';
                document.getElementById('actionHint').textContent='👆 为【'+action.skill_name+'】选择绿色目标';
                highlightTargets(true,action.valid_targets||[]);
                document.getElementById('playBtn').textContent='发动';
                updateButtons();
            }else{
                L('发动【'+action.skill_name+'】');
                gameClient.playerAction(action,[]);
                document.getElementById('playBtn').textContent='出牌';
            }
        }

        function openAISettings(playerId){
            if(!latestState)return;
            var p=latestState.players.find(function(x){return x.id===playerId});
            if(!p||!p.is_ai)return;
            var c=p.ai_config||{};
            document.getElementById('aiSettingsTitle').textContent=p.name+' · AI模型设置';
            document.getElementById('aiSettingPlayerId').value=p.id;
            document.getElementById('aiSettingProvider').value=c.provider||'deepseek';
            document.getElementById('aiSettingModel').value=c.model||'deepseek-chat';
            document.getElementById('aiSettingUrl').value=c.api_url||'';
            document.getElementById('aiSettingKey').value='';
            document.getElementById('aiSettingTemperature').value=c.temperature===undefined?0.8:c.temperature;
            document.getElementById('aiSettingThinking').checked=!!c.thinking;
            document.getElementById('aiSettingsModal').classList.add('show');
        }

        function saveAISettings(){
            gameClient.send({
                type:'update_ai_config',
                player_id:parseInt(document.getElementById('aiSettingPlayerId').value),
                config:{
                    provider:document.getElementById('aiSettingProvider').value,
                    model:document.getElementById('aiSettingModel').value.trim(),
                    api_url:document.getElementById('aiSettingUrl').value.trim(),
                    api_key:document.getElementById('aiSettingKey').value.trim(),
                    temperature:parseFloat(document.getElementById('aiSettingTemperature').value),
                    thinking:document.getElementById('aiSettingThinking').checked
                }
            });
        }

        function doEndGame(){
            if(!confirm('确定结束本局游戏吗？本局将记为主动终止。'))return;
            document.getElementById('quitBtn').disabled=true;
            gameClient.send({type:'end_game',reason:'玩家主动结束游戏'});
        }

        function doPlay(){
            var act,tids=[];
            if(pendingAction){
                tids=pendingAction.target_ids||[];
                if(pendingAction.type==='use_skill')act=Object.assign({},pendingAction);
                else act={type:'play_card',card_index:pendingAction.card_index};
            }else if(sel!==null){
                act={type:'play_card',card_index:sel};
            }else return;

            var card=Number.isInteger(act.card_index)?hand[act.card_index]:null;
            if(card)L('提交使用【'+card.name+'】');
            if(act.type==='use_skill')L('提交发动【'+act.skill_name+'】');
            gameClient.playerAction(act,tids);
            sel=null;pendingAction=null;needTarget=false;selectedLegalAction=null;
            highlightTargets(false,[]);
            document.querySelectorAll('.pl.chosen').forEach(function(p){p.classList.remove('chosen')});
            document.getElementById('playBtn').disabled=true;
            document.getElementById('playBtn').textContent='出牌';
        }

        function doEnd(){
            L('结束阶段');
            gameClient.playerAction({type:'end_phase'});
            sel=null;hand=[];renderHand();
            document.getElementById('playBtn').disabled=true;
            document.getElementById('playBtn').textContent='出牌';
            document.getElementById('endBtn').disabled=true;
            document.getElementById('actionHint').style.display='none';
            highlightTargets(false,[]);
            document.querySelectorAll('.pl.chosen').forEach(function(p){p.classList.remove('chosen')});
        }

        gameClient.connect();

        function toggleLog(){
            var logWrap=document.getElementById("logWrap");
            var btn=document.getElementById("logToggle");
            if(logWrap.classList.contains("expanded")){
                logWrap.classList.remove("expanded");
                btn.textContent="▼";
            }else{
                logWrap.classList.add("expanded");
                btn.textContent="▲";
            }
        }

        function updateLogPosition(){
            var myarea=document.getElementById("myarea");
            if(!myarea)return;
            var rect=myarea.getBoundingClientRect();
            var logWrap=document.getElementById("logWrap");
            logWrap.style.bottom=(window.innerHeight-rect.top+6)+"px";
        }

        window.addEventListener("resize",updateLogPosition);
        window.addEventListener("orientationchange",updateLogPosition);
        setTimeout(updateLogPosition,100);
        L('连接中...');
    </script>
</body>
</html>
