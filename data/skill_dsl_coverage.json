        "version": 1,
        "trigger": "phase_start",
        "condition": {
          "op": "eq",
          "path": "event.phase",
          "value": "draw"
        },
        "skip_default": true,
        "modifiers": [
          {
            "stat": "hand_limit",
            "op": "max",
            "value": {
              "path": "owner.max_hp"
            }
          }
        ],
        "effects": [
          {
            "type": "draw_cards",
            "target": "owner",
            "count": 3,
            "reason": "英姿"
          },
          {
            "type": "announce"
          }
        ]
      },
      "supported": true
    },
