#!/data/data/com.termux/files/usr/bin/bash
# AI三国杀酒馆统一启动脚本
# 用法：
#   bash start.sh                    # 前台启动
#   bash start.sh start --background # 后台启动
#   bash start.sh restart --background
#   bash start.sh stop | status

set -u
PROJECT_DIR="/data/data/com.termux/files/home/sanguosha_tavern"
PID_FILE="$PROJECT_DIR/logs/game_server.pid"
LOG_FILE="$PROJECT_DIR/logs/server.log"
ACTION="${1:-start}"
MODE="${2:-foreground}"

cd "$PROJECT_DIR" || exit 1
mkdir -p logs

find_server_pid() {
    if [ -f "$PID_FILE" ]; then
        local saved
        saved=$(cat "$PID_FILE" 2>/dev/null || true)
        if [ -n "$saved" ] && kill -0 "$saved" 2>/dev/null; then
            echo "$saved"
            return 0
        fi
        rm -f "$PID_FILE"
    fi
    pgrep -f "python.*game_server.py" 2>/dev/null | head -n 1
}

show_status() {
    local pid
    pid=$(find_server_pid || true)
    if [ -n "$pid" ]; then
        echo "✅ 服务器正在运行，PID=$pid"
        echo "   HTTP: http://localhost:8888"
        echo "   WS:   ws://localhost:8889"
        return 0
    fi
    echo "⏹️ 服务器未运行"
    return 1
}

stop_server() {
    local pid
    pid=$(find_server_pid || true)
    if [ -z "$pid" ]; then
        echo "⏹️ 服务器未运行"
        rm -f "$PID_FILE"
        return 0
    fi
    echo "正在停止服务器 PID=$pid ..."
    kill "$pid" 2>/dev/null || true
    for _ in 1 2 3 4 5; do
        if ! kill -0 "$pid" 2>/dev/null; then
            rm -f "$PID_FILE"
            echo "✅ 服务器已停止"
            return 0
        fi
        sleep 1
    done
    echo "⚠️ 普通停止超时，执行强制停止"
    kill -9 "$pid" 2>/dev/null || true
    rm -f "$PID_FILE"
    echo "✅ 服务器已停止"
}

check_dependencies() {
    if ! command -v python >/dev/null 2>&1; then
        echo "❌ 未安装Python：pkg install python"
        exit 1
    fi
    if ! python -c "import websockets, httpx" >/dev/null 2>&1; then
        echo "❌ 缺少依赖，请运行：pip install websockets httpx"
        exit 1
    fi
}

start_server() {
    local pid
    pid=$(find_server_pid || true)
    if [ -n "$pid" ]; then
        echo "⚠️ 服务器已经运行，PID=$pid"
        echo "如需重启：bash start.sh restart --background"
        return 0
    fi

    check_dependencies
    echo "╔════════════════════════════════════════╗"
    echo "║       AI三国杀酒馆 · P0服务器         ║"
    echo "╚════════════════════════════════════════╝"
    echo "HTTP: http://localhost:8888"
    echo "WS:   ws://localhost:8889"

    if [ "$MODE" = "--background" ] || [ "$MODE" = "background" ]; then
        nohup python -u game_server.py >>"$LOG_FILE" 2>&1 &
        pid=$!
        echo "$pid" > "$PID_FILE"
        sleep 1
        if kill -0 "$pid" 2>/dev/null; then
            echo "✅ 已后台启动，PID=$pid"
            echo "日志：$LOG_FILE"
        else
            echo "❌ 启动失败，最近日志："
            tail -30 "$LOG_FILE" 2>/dev/null || true
            rm -f "$PID_FILE"
            exit 1
        fi
    else
        echo "按 Ctrl+C 停止服务器"
        echo "$$" > "$PID_FILE.shell"
        trap 'rm -f "$PID_FILE" "$PID_FILE.shell"' EXIT INT TERM
        python -u game_server.py
    fi
}

case "$ACTION" in
    start) start_server ;;
    stop) stop_server ;;
    restart)
        stop_server
        # 等待Python线程和监听端口完全释放，避免旧进程残影被误判。
        for _ in 1 2 3 4 5; do
            [ -z "$(find_server_pid || true)" ] && break
            sleep 1
        done
        start_server
        ;;
    status) show_status ;;
    *)
        echo "用法：bash start.sh [start|stop|restart|status] [--background]"
        exit 2
        ;;
esac
